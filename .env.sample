STUDIO_PORT=5000

# Base URL of the Soul backend API this Studio instance talks to.
# Leave empty (or unset) for same-origin deployments -- e.g. when Soul core
# mounts this app itself via `-S`/`--studio` at /studio, requests to /api
# and /ws already resolve against the same origin with no configuration.
# Set this explicitly only for standalone/cross-origin dev, e.g.
# PUBLIC_SOUL_API_URL=http://localhost:8000
PUBLIC_SOUL_API_URL=

# Directory scanned for Studio plugins at dev/build time (see
# docs/extensions/). Defaults to `_studio_extensions` if that directory
# exists; only set this to point somewhere else.
STUDIO_EXTENSIONS_DIR=
